            <CustomItem>
              <ExpressionBinding>
                <ScriptBlock>
        if ($_.SetBlock) {
            "ParameterSet : $($_.ParameterSet)`n" +
            "IsDefault    : $($_.IsDefault)`n" +
            "SetBlock     :" +
            "$($_.SetBlock.Split("`n") | ForEach-Object { "`n           $($_.Trim())" })" +
            "`nHashBlock  :" +
            "$($_.HashBlock.Split("`n") | ForEach-Object { "`n           $($_)" })"
        }
        elseif ($_.ParameterSet) {
            "ParameterSet : $($_.ParameterSet)`n" +
            "IsDefault    : $($_.IsDefault)`n" +
            "Parameters   : $($_.HashBlock)`n"
        }
        else {
            "$($_.HashBlock)"
        }
    </ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
